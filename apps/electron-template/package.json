{
  "name": "series-electron-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal application template for the Series UI framework",
  "author": "Application owner",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/prepare.mjs && electron-vite dev",
    "dev:browser": "node scripts/prepare.mjs && vite --config vite.browser.config.ts",
    "build": "node scripts/prepare.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "package:dir": "electron-builder --dir --config electron-builder.cjs",
    "package:win": "electron-builder --win nsis --config electron-builder.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@series/ui": "0.1.0",
    "@series/electron": "0.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "lucide-react": "1.33.0"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "@vitejs/plugin-react": "5.1.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
