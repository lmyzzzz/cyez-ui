{
  "name": "@series/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-first application UI, CSS themes and desktop shell",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/types/theme/index.d.ts",
      "import": "./dist/theme.js"
    },
    "./bootstrap": {
      "types": "./dist/types/startup/bootstrap.d.ts",
      "import": "./dist/bootstrap.js"
    },
    "./styles.css": "./dist/style.css",
    "./app.css": "./dist/app.css",
    "./appearance-init.js": "./dist/appearance-init.js"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "react-router-dom": ">=7 <8"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "lucide-react": "^1.33.0",
    "sonner": "^2.0.8"
  }
}
